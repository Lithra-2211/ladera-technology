# Twenty Backend Environment Configuration
PORT=3000
SERVER_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
AUTH_COOKIE_ALLOWED_ORIGINS=http://localhost:3001
AUTH_COOKIE_SAME_SITE=lax

# Database Configuration
# PG_DATABASE_URL=postgres://twenty:1234@127.0.0.1:5433/default
PG_DATABASE_URL=postgres://twenty:twenty@127.0.0.1:5434/default

REDIS_URL=redis://127.0.0.1:6379

# Storage and Security
STORAGE_TYPE=local
APP_SECRET=twenty-secret-key-change-in-production-at-least-32-chars
NODE_ENV=development
PG_SSL_MODE=disable
PG_SSL_REJECT_UNAUTHORIZED=false
