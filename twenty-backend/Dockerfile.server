# Standalone Headless Twenty Backend
FROM node:24.19.0-alpine3.23 AS builder
WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package.json yarn.lock .yarnrc.yml tsconfig.base.json nx.json ./
COPY .yarn/releases ./.yarn/releases
COPY .yarn/patches ./.yarn/patches

COPY packages/twenty-shared ./packages/twenty-shared
COPY packages/twenty-emails ./packages/twenty-emails
COPY packages/twenty-client-sdk ./packages/twenty-client-sdk
COPY packages/twenty-server ./packages/twenty-server

RUN yarn install --immutable
RUN npx nx build twenty-shared
RUN npx nx build twenty-server

# Production Runner Stage
FROM node:24.19.0-alpine3.23 AS runner
WORKDIR /app

RUN apk add --no-cache curl postgresql18-client

COPY --from=builder /app/package.json /app/yarn.lock /app/.yarnrc.yml /app/
COPY --from=builder /app/.yarn /app/.yarn
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages/twenty-shared/dist /app/packages/twenty-shared/dist
COPY --from=builder /app/packages/twenty-shared/package.json /app/packages/twenty-shared/
COPY --from=builder /app/packages/twenty-emails/dist /app/packages/twenty-emails/dist
COPY --from=builder /app/packages/twenty-emails/package.json /app/packages/twenty-emails/
COPY --from=builder /app/packages/twenty-server/dist /app/packages/twenty-server/dist
COPY --from=builder /app/packages/twenty-server/package.json /app/packages/twenty-server/
COPY --from=builder /app/packages/twenty-server/patches /app/packages/twenty-server/patches

WORKDIR /app/packages/twenty-server
ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "dist/main"]
